        "assertions": {
          "final_status_in": [
            "completed",
            "clarifying",
            "blocked",
            "chat"
          ],
          "bot_reply_excludes_all": [
            "task_",
            "tool_name",
            "operation:",
            "data analysis project",
            "sample data analysis",
            "Chromecast"
          ],
          "bot_reply_contains_any": [
            "printer",
            "print"
          ]
        },
        "expects_task": "auto"
      }
    ]
