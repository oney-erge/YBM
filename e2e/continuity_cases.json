[
  {
    "id": "cont_plan_for_it_stays_on_the_goal",
    "requirement": "continuity",
    "message": "The label printer in the office stopped printing since yesterday. Look into it.",
    "setup": [],
    "tags": [
      "continuity",
      "followup"
    ],
    "suites": [
      "continuity"
    ],
    "heldout": false,
    "size": "small",
    "timeout_seconds": 900,
    "claims": true,
    "rubric": [
      "Looks at the printer's state or explains what it can check",
      "The follow-up plan is about the printer, not about the words of the follow-up"
    ],
    "assertions": {
      "final_status_in": [
        "completed",
        "clarifying",
        "blocked",
        "chat"
      ],
      "bot_reply_excludes_all": [
        "task_",
        "tool_name",
        "operation:"
      ]
    },
    "source_file": "continuity_cases.json",
    "expects_task": "auto",
    "follow_ups": [
      {
        "id": "plan",
        "message": "Ok, give me a plan to actually fix it properly.",
        "timeout_seconds": 600,
        "assertions": {
          "final_status_in": [
            "completed",
            "clarifying",
            "blocked",
            "chat"
          ],
          "bot_reply_excludes_all": [
            "task_",
            "tool_name",
            "operation:",
            "data analysis project",
            "sample data analysis",
            "Chromecast"
          ],
          "bot_reply_contains_any": [
            "printer",
            "print"
          ]
        },
        "expects_task": "auto"
      }
    ]
  },
