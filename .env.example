# Nothing in this file is required. YBM creates its own .env on first run with a
# generated admin token and vault key, and picks a model from what it finds (a
# provider API key below, a running Ollama, or YBM_LOCALDEPLOY_ROOT). Copy this
# file only to choose a value yourself.

# Telegram
AGENT_CHANNELS__TELEGRAM__TOKEN_ENV=TELEGRAM_BOT_TOKEN
# TELEGRAM_BOT_TOKEN=

# Admin UI
AGENT_SERVER__ADMIN_ENABLED=true
AGENT_SERVER__ADMIN_TOKEN_ENV=AGENT_ADMIN_TOKEN
# Generated for you; set it only to use a token of your own.
# AGENT_ADMIN_TOKEN=

# Model provider keys. The first one found is used (in this order) when no model
# is configured yet; saving a model in the console always wins.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# LOCAL_LLM_API_KEY=

# LocalDeploy (optional local OpenAI-compatible LLM server this stack can launch).
# Only needed if you run a local LocalDeploy checkout; setting it makes YBM use it
# and start it with the stack.
# YBM_LOCALDEPLOY_ROOT=C:\path\to\LocalDeploy
